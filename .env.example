# Uptime-Kuma with SQLite Backup - Environment Variables

# =============================================================================
# Version Configuration
# =============================================================================
UPTIME_KUMA_VERSION=2.0.2

# =============================================================================
# Azure Blob Storage Configuration (Required for backup)
# =============================================================================
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_STORAGE_KEY=your_storage_account_key

# =============================================================================
# Database Backup Settings
# =============================================================================
DB_BACKUP_ENABLED=true
DB_BACKUP_INTERVAL=5m
DB_FAIL_ON_RESTORE_ERROR=false
AZURE_BACKUP_CONTAINER=kuma-backup
AZURE_BACKUP_FILENAME=kuma.db

# =============================================================================
# Upload Sync Settings (for icons and images)
# =============================================================================
UPLOAD_SYNC_ENABLED=true
UPLOAD_SYNC_INTERVAL=5m
AZURE_UPLOAD_CONTAINER=kuma-uploads

# =============================================================================
# Keycloak/OIDC - required
# =============================================================================
OAUTH2_PROXY_OIDC_ISSUER_URL=https://keycloak.example.com/realms/my-realm
OAUTH2_PROXY_CLIENT_ID=uptime-kuma
OAUTH2_PROXY_CLIENT_SECRET=change-me
OAUTH2_PROXY_COOKIE_SECRET=change-me-with-a-persistent-random-secret
OAUTH2_PROXY_REDIRECT_URL=https://status.example.com/oauth2/callback

# Optional: restrict access to a Keycloak realm role
# OAUTH2_PROXY_ALLOWED_ROLES=uptime-kuma-admin

# Or a Keycloak client role
# OAUTH2_PROXY_ALLOWED_ROLES=uptime-kuma:admin

# If oauth2-proxy itself is behind another reverse proxy/LB and you need it to
# trust X-Forwarded-* headers, enable reverse-proxy mode and restrict trusted IPs.
# OAUTH2_PROXY_REVERSE_PROXY=true
# OAUTH2_PROXY_TRUSTED_PROXY_IPS=10.0.0.0/8

# For local HTTP-only testing only. Keep true in production HTTPS.
# OAUTH2_PROXY_COOKIE_SECURE=false

# Optional public Kuma endpoints. The Dockerfile default only bypasses auth for
# status pages and their required assets/API. If you use Push monitors or badge
# endpoints, extend OAUTH2_PROXY_SKIP_AUTH_ROUTES explicitly.
